APP_NAME=HATAB
APP_ENV=local
# Fill with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs no server: the file is database/database.sqlite.
# For MySQL or PostgreSQL set DB_CONNECTION=mysql (or pgsql) and the lines below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hatab
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

# The web app's origins that may call this API, separated by commas.
CORS_ALLOWED_ORIGINS=https://ahmed-abdulraziq.github.io,http://localhost:5173,http://localhost:4173

BCRYPT_ROUNDS=12
